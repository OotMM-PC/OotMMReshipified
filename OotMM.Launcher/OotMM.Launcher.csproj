<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <QtExportAs>metadata</QtExportAs>
    </PropertyGroup>

    <ItemGroup>
        <QtResource Include="Assets\Icons\*.png" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Assets\Maps\*" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="QtGroup.Qt.Bridge.CSharp.win-x64" Version="0.5.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OotMM.Launcher.Logic\OotMM.Launcher.Logic.csproj" />
    </ItemGroup>

    <Target Name="PublishQtRuntime" AfterTargets="Publish">
        <ItemGroup>
            <_QtRuntimeFile Include="$(TargetDir)**\*"
                            Exclude="$(TargetDir)**\*.pdb;$(TargetDir)qtdeploy.txt;$(TargetDir)launcher.ui.json;$(TargetDir)world_state\**" />
        </ItemGroup>
        <Copy SourceFiles="@(_QtRuntimeFile)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>
