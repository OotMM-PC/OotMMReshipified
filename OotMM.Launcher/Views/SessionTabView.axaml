<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.SessionTabView"
             x:DataType="vm:SessionTabViewModel">

    <ScrollViewer>
    <StackPanel Spacing="8">
        <TextBlock Classes="sectionTitle" Text="Session" />
        <Button Content="Open the game's menu" HorizontalAlignment="Stretch"
                Command="{Binding OpenGameMenuCommand}"
                ToolTip.Tip="Opens the running game's own settings menu (graphics, audio, input). You can also just press Esc in the game." />
        <Button Content="Restart active game" HorizontalAlignment="Stretch"
                Command="{Binding RestartGameCommand}"
                ToolTip.Tip="Closes and relaunches the active game from its last save." />
        <Button Content="Switch to the other game" HorizontalAlignment="Stretch"
                Foreground="#E08A7A" IsVisible="{Binding ShowSwitchGame}"
                Command="{Binding SwitchGameCommand}"
                ToolTip.Tip="Dev mode: forcing a game switch outside a cross-game load zone may leave logic." />
        <Button Content="End session" HorizontalAlignment="Stretch"
                Command="{Binding EndSessionCommand}"
                ToolTip.Tip="Saves are kept — relaunching this seed resumes where you left off." />

        <!-- Game speed: applied live through the roster meta both games poll. -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowSpeed}" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Game speed" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="Reset"
                        IsVisible="{Binding ShowSpeedReset}"
                        Command="{Binding ResetSpeedCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Slider Width="240" Minimum="{Binding SpeedMin}" Maximum="{Binding SpeedMax}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding SpeedPercent}"
                        ToolTip.Tip="Speeds up or slows down the game itself (0% freezes it). 100% is normal speed. On a server, the host sets the allowed range." />
                <TextBlock Classes="dim" Text="{Binding SpeedText}" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Content="Sync updates to render framerate" IsChecked="{Binding SpeedSmooth}"
                      ToolTip.Tip="Paces the scaled game updates against the render framerate instead of whole-frame steps, so speed changes stay smooth." />
        </StackPanel>

        <Separator Margin="0,6" />
        <Button Content="{Binding ResetButtonText}" HorizontalAlignment="Stretch"
                Foreground="#E86A5A" IsVisible="{Binding ShowReset}"
                Command="{Binding ResetProgressCommand}"
                ToolTip.Tip="Permanently deletes ALL progress for this seed: both games' saves, the shared ledger, and the check log. Cannot be undone." />
        <TextBlock Classes="dim" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding ShowUnavailableNote}"
                   Text="{Binding UnavailableNote}" />
    </StackPanel>
    </ScrollViewer>

</UserControl>
