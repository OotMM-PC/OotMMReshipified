<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.GameCardView"
             x:DataType="vm:GameCardViewModel">

    <ContentControl Classes="bracketCard" VerticalAlignment="Stretch">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://OotMM.Launcher/Assets/Icons/OcarinaOfTime.png"
                       Width="34" Height="34" IsVisible="{Binding IsOot}" />
                <Image Source="avares://OotMM.Launcher/Assets/Icons/FierceDeityMask.png"
                       Width="34" Height="34" IsVisible="{Binding !IsOot}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="sectionTitle" Classes.violet="{Binding !IsOot}"
                               Text="{Binding Title}" />
                    <TextBlock Classes="dim" FontSize="12" Text="{Binding PortSubtitle}" />
                </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,8,Auto">
                <TextBox Grid.Column="0" PlaceholderText="{Binding ExeHint}"
                         Text="{Binding ExePath}" />
                <Button Grid.Column="2" Content="Browse"
                        Command="{Binding BrowseExeCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,8,Auto">
                <TextBlock Grid.Column="0" Classes="dim" Classes.error="{Binding StatusIsError}"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{Binding StatusText}" />
                <Button Grid.Column="2" Content="Settings…" IsEnabled="False"
                        ToolTip.Tip="Per-game settings editor arrives with the GameConfig module." />
            </Grid>

            <Expander Header="{Binding ModsSummary}" IsVisible="{Binding HasMods}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="dim" FontSize="12"
                               Text="Load order: the top mod overrides everything below it. Changes apply on the next game launch." />
                    <TextBlock Classes="dim" FontSize="12"
                               Text="Ctrl/Shift-click selects several; drag the selection or use the block buttons." />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="orderArrow" Content="⤒"
                                Command="{Binding MoveSelectedTopCommand}"
                                ToolTip.Tip="Move the selected mods to the top (highest priority)." />
                        <Button Classes="orderArrow" Content="▲"
                                Command="{Binding MoveSelectedUpCommand}"
                                ToolTip.Tip="Move the selected mods up one slot." />
                        <Button Classes="orderArrow" Content="▼"
                                Command="{Binding MoveSelectedDownCommand}"
                                ToolTip.Tip="Move the selected mods down one slot." />
                        <Button Classes="orderArrow" Content="⤓"
                                Command="{Binding MoveSelectedBottomCommand}"
                                ToolTip.Tip="Move the selected mods to the bottom (lowest priority)." />
                    </StackPanel>
                    <ListBox x:Name="ModsList" ItemsSource="{Binding Mods}"
                             SelectionMode="Multiple" Background="Transparent"
                             DragDrop.AllowDrop="True">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vm:ModEntryViewModel">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="5" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModEntryViewModel">
                                <!-- The name stays OUTSIDE the checkbox: clicking it selects and
                                     drags; only the box itself toggles enable. -->
                                <Grid ColumnDefinitions="Auto,4,Auto,10,Auto,8,*" Margin="0,1"
                                      Background="Transparent">
                                    <Button Grid.Column="0" Classes="orderArrow" Content="▲"
                                            Command="{Binding MoveUpCommand}"
                                            IsEnabled="{Binding !IsFirst}"
                                            ToolTip.Tip="Raise priority (load over the mod above)." />
                                    <Button Grid.Column="2" Classes="orderArrow" Content="▼"
                                            Command="{Binding MoveDownCommand}"
                                            IsEnabled="{Binding !IsLast}"
                                            ToolTip.Tip="Lower priority (let the mod above load over this one)." />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}"
                                              IsEnabled="{Binding !Required}"
                                              Padding="0" MinWidth="0"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Enable or disable this archive." />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                Background="Transparent" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Classes="dim" Text="(required)"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Required}"
                                                   ToolTip.Tip="Cross-game item models — the port needs this archive." />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="error" TextWrapping="Wrap"
                               IsVisible="{Binding HasLoadOrderError}"
                               Text="{Binding LoadOrderError}" />
                </StackPanel>
            </Expander>

            <!-- MM only: render human Link from the player's OoT model archives. -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsOot}">
                <CheckBox IsChecked="{Binding PortAdultModel}"
                          ToolTip.Tip="Adult Link in MM renders your selected OoT model; unchecked, the vanilla adult is used.">
                    <TextBlock Text="Use my OoT model for adult Link" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox IsChecked="{Binding PortChildModel}"
                          ToolTip.Tip="Overrides MM human-form model mods; Deku, Goron, Zora and Fierce Deity stay with MM mods.">
                    <TextBlock Text="Use my OoT child model as MM's human Link" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding HasModelPortStatus}"
                           Text="{Binding ModelPortStatus}" />
            </StackPanel>
        </StackPanel>
    </ContentControl>

</UserControl>
