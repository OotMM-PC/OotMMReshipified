<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- WinExe so no console window opens behind the launcher on Windows;
             behaves identically to Exe on Linux/macOS. -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Compiled bindings: every binding is type-checked at build time, so a renamed
             view-model property is a compile error instead of a silently dead control. -->
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- NativeControlHost (the embedded game window) requires the supported-OS manifest. -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\OotMM.Core\OotMM.Core.csproj" />
    </ItemGroup>

</Project>
