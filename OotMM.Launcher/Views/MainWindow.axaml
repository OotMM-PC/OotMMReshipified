<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OotMM.Launcher.ViewModels"
        x:Class="OotMM.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OoTMM PC"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextBrush}">

    <!-- Stage swap: ConfigViewModel or RuntimeViewModel, resolved to a view
         by the ViewLocator registered in App.axaml. -->
    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
