<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         OoTMM palette and iconography.
         Accent brushes (gold/violet) live in App.axaml and are swapped
         at runtime; everything here is accent-agnostic or binds them
         via DynamicResource.
         ============================================================ -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Warm near-black, like the original launcher backdrop. -->
            <SolidColorBrush x:Key="BgDeepBrush" Color="#0E0B07" />
            <SolidColorBrush x:Key="BgPanelBrush" Color="#191309" />
            <SolidColorBrush x:Key="BgPanelRaisedBrush" Color="#221A0D" />
            <SolidColorBrush x:Key="TextBrush" Color="#E8DCC2" />
            <SolidColorBrush x:Key="TextDimBrush" Color="#9C9077" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#8CD980" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#EB6657" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2BF40" />
            <!-- MM identity color, used regardless of the active accent. -->
            <SolidColorBrush x:Key="MmVioletBrush" Color="#A97FE0" />

            <!-- Icon silhouettes, 24x24 grid. Hand-authored stand-ins for the old
                 launcher's texture icons; swap for real art later without touching
                 any view (views reference these keys only). -->
            <StreamGeometry x:Key="IconTriforce">M12 2 L17 11 L7 11 Z M7 11 L12 20 L2 20 Z M17 11 L22 20 L12 20 Z</StreamGeometry>
            <StreamGeometry x:Key="IconMap">M3 5 L9 3 L15 5 L21 3 L21 19 L15 21 L9 19 L3 21 Z M9 5.2 L9 16.8 L10.5 17.3 L10.5 5.7 Z M15 6.7 L15 18.3 L16.5 17.8 L16.5 6.2 Z</StreamGeometry>
            <StreamGeometry x:Key="IconNotebook">M6 3 L20 3 L20 21 L6 21 Z M8 6 L18 6 L18 7.5 L8 7.5 Z M8 10 L18 10 L18 11.5 L8 11.5 Z M8 14 L18 14 L18 15.5 L8 15.5 Z M4 4.5 L7 4.5 L7 6 L4 6 Z M4 11 L7 11 L7 12.5 L4 12.5 Z M4 17.5 L7 17.5 L7 19 L4 19 Z</StreamGeometry>
            <StreamGeometry x:Key="IconSword">M12 1 L14.5 4 L14.5 13 L9.5 13 L9.5 4 Z M6.5 13.8 L17.5 13.8 L17.5 15.8 L6.5 15.8 Z M10.8 15.8 L13.2 15.8 L13.2 21 L10.8 21 Z</StreamGeometry>
            <StreamGeometry x:Key="IconLens">M10.5 2 A8.5 8.5 0 1 0 10.5 19 A8.5 8.5 0 1 0 10.5 2 Z M10.5 5 A5.5 5.5 0 1 1 10.5 16 A5.5 5.5 0 1 1 10.5 5 Z M16.8 15.4 L22 20.6 L20.6 22 L15.4 16.8 Z</StreamGeometry>
            <StreamGeometry x:Key="IconCompass">M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M12 4.5 A7.5 7.5 0 1 1 12 19.5 A7.5 7.5 0 1 1 12 4.5 Z M12 6.5 L15 15.5 L12 13.4 L9 15.5 Z</StreamGeometry>
            <!-- Majora's Mask: heart-shaped body, two horns, diamond eye cutouts. -->
            <StreamGeometry x:Key="IconMajora">M12 5.2 C10.8 3.2 8 2.6 6 3.8 C3.4 5.3 2.6 8.6 3.6 11.4 C4.8 14.8 8.2 17.8 12 20.6 C15.8 17.8 19.2 14.8 20.4 11.4 C21.4 8.6 20.6 5.3 18 3.8 C16 2.6 13.2 3.2 12 5.2 Z M7.4 3.4 L5.2 0.6 L4 3.9 Z M16.6 3.4 L18.8 0.6 L20 3.9 Z M8.6 8.2 L10.4 10 L8.6 11.8 L6.8 10 Z M15.4 8.2 L17.2 10 L15.4 11.8 L13.6 10 Z</StreamGeometry>
            <!-- Moon's Tear droplet, for the multiworld panel. -->
            <StreamGeometry x:Key="IconTear">M12 2.5 C12 2.5 5.5 10 5.5 14.8 A6.5 6.5 0 0 0 18.5 14.8 C18.5 10 12 2.5 12 2.5 Z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Typography -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LetterSpacing" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle.violet">
        <Setter Property="Foreground" Value="{StaticResource MmVioletBrush}" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>

    <!-- Panels: bordered cards used for every grouped section. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Card with the original launcher's gold corner brackets. -->
    <Style Selector="ContentControl.bracketCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Classes="card">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Border Classes="bracket" BorderThickness="2,2,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Border Classes="bracket" BorderThickness="0,2,2,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <Border Classes="bracket" BorderThickness="2,0,0,2"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <Border Classes="bracket" BorderThickness="0,0,2,2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.bracket">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Icons -->
    <Style Selector="Path.icon">
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Path.pulse, Image.pulse">
        <Style.Animations>
            <!-- The Triforce heartbeat from the original hero header. -->
            <Animation Duration="0:0:2.4" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.45" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.45" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Compact tree-node look for expanders, closer to the original's
         arrow-plus-text rows than Fluent's boxed default. -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4,0,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Tiny priority arrows in the mods list. -->
    <Style Selector="Button.orderArrow">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The big SETUP / START ADVENTURE button. -->
    <Style Selector="Button.hero">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="36,16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.hero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Quiet inline link-style button (e.g. "preview runtime layout"). -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrightBrush}" />
    </Style>

    <!-- Sidebar icon tab rail: a ListBox whose items are just icons. -->
    <Style Selector="ListBox.tabRail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.tabRail ListBoxItem">
        <Setter Property="Padding" Value="0,9" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.tabRail ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>

</Styles>
