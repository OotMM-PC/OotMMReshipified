<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             xmlns:views="using:OotMM.Launcher.Views"
             x:Class="OotMM.Launcher.Views.RuntimeView"
             x:DataType="vm:RuntimeViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- Game area: the embedded game window docks into GameHostControl. -->
        <Border Grid.Column="0" Margin="10" CornerRadius="10"
                Background="{StaticResource BgPanelBrush}">
            <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="460">
                    <Image Classes="pulse" Source="avares://OotMM.Launcher/Assets/Icons/OcarinaOfTime.png"
                           Width="64" Height="64" HorizontalAlignment="Center"
                           IsVisible="{Binding ActiveIsOot}" />
                    <Image Classes="pulse" Source="avares://OotMM.Launcher/Assets/Icons/FierceDeityMask.png"
                           Width="64" Height="64" HorizontalAlignment="Center"
                           IsVisible="{Binding !ActiveIsOot}" />
                    <TextBlock Classes="dim" TextAlignment="Center" TextWrapping="Wrap"
                               Text="The game window docks here once it starts." />
                    <Button Classes="link" HorizontalAlignment="Center"
                            Content="← Back to configuration"
                            Command="{Binding BackToConfigCommand}"
                            IsVisible="{Binding IsPreview}" />
                </StackPanel>
                <views:GameHostControl x:Name="GameHost" IsVisible="{Binding !IsPreview}" />
                <TextBlock Classes="warn" Margin="14,10"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsVisible="{Binding IsPreview}"
                           Text="LAYOUT PREVIEW — no live session" />
            </Panel>
        </Border>

        <!-- Sidebar: exactly one of the three states renders. -->
        <LayoutTransformControl Grid.Column="1" LayoutTransform="{Binding SidebarScaleTransform}">
        <Panel>

            <!-- 1) End-of-session drain: no controls on purpose. Exposing
                 relaunch/reset while the last durable inbox writes are pending
                 could orphan a freshly started child process. -->
            <Border Width="380" Padding="16" IsVisible="{Binding IsFinalizingSync}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="sectionTitle" Text="Finalizing multiworld sync" />
                    <Separator />
                    <TextBlock Classes="dim" TextWrapping="Wrap"
                               Text="Waiting for all received item packets to be written safely. This window will continue automatically." />
                </StackPanel>
            </Border>

            <!-- 2) Collapsed strip: just the expand handle. -->
            <Button Width="30" Margin="0,10,6,10" Content="&lt;"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    IsVisible="{Binding ShowCollapsedStrip}"
                    Command="{Binding ExpandSidebarCommand}"
                    ToolTip.Tip="Expand the sidebar" />

            <!-- 3) Full panel -->
            <Border Width="380" Padding="14" IsVisible="{Binding ShowFullSidebar}">
                <DockPanel>

                    <!-- Header: mini Triforce + wordmark + collapse chevron. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,8,*,Auto">
                        <Path Grid.Column="0" Classes="icon pulse"
                              Data="{StaticResource IconTriforce}" Width="22" Height="20" />
                        <TextBlock Grid.Column="2" Classes="sectionTitle" FontSize="18"
                                   Text="OoTMM" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Content="&gt;" Width="28"
                                Command="{Binding CollapseSidebarCommand}"
                                ToolTip.Tip="Collapse the sidebar" />
                    </Grid>

                    <!-- Active-game banner with live status dot. -->
                    <Border DockPanel.Dock="Top" Classes="card" Padding="10" Margin="0,10,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/OcarinaOfTime.png"
                                   Width="32" Height="32" IsVisible="{Binding ActiveIsOot}" />
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/FierceDeityMask.png"
                                   Width="32" Height="32" IsVisible="{Binding !ActiveIsOot}" />
                            <StackPanel>
                                <TextBlock Classes="sectionTitle" Text="{Binding ActiveGameTitle}" />
                                <TextBlock Classes.success="{Binding IsRunning}"
                                           Classes.error="{Binding !IsRunning}"
                                           Text="{Binding RunStatusText}" />
                                <TextBlock Classes="dim" FontSize="11"
                                           IsVisible="{Binding ShowMultiworldStatus}"
                                           Text="{Binding MultiworldStatus}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Icon tab rail: dungeon map = tracker, notebook = log,
                         sword = session, lens = options, compass = progress. -->
                    <ListBox DockPanel.Dock="Top" Classes="tabRail"
                             SelectedIndex="{Binding SelectedTabIndex}">
                        <ListBoxItem ToolTip.Tip="Tracker — open checks">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/DungeonMap.png" Width="26" Height="26" />
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Check log">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/BombersNotebook.png" Width="26" Height="26" />
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Session — restart / reset">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/KokiriSword.png" Width="26" Height="26" />
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Options &amp; appearance">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/LensOfTruth.png" Width="26" Height="26" />
                        </ListBoxItem>
                        <ListBoxItem ToolTip.Tip="Progress — both games at a glance">
                            <Image Source="avares://OotMM.Launcher/Assets/Icons/Compass.png" Width="26" Height="26" />
                        </ListBoxItem>
                    </ListBox>

                    <!-- Active tab body; each tab owns its scrolling so long
                         lists can virtualize. -->
                    <ContentControl Margin="0,10,0,0" Content="{Binding CurrentTab}" />

                </DockPanel>
            </Border>

        </Panel>
        </LayoutTransformControl>
    </Grid>

</UserControl>
