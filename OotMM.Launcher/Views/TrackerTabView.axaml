<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.TrackerTabView"
             x:DataType="vm:TrackerTabViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding CollectedFraction}" Height="16" />
            <TextBlock Classes="dim" Text="{Binding SummaryText}" />
            <TextBlock Classes="success" Text="{Binding InLogicText}"
                       ToolTip.Tip="Reachable with your current items, per the seed's logic." />
            <TextBlock Classes="dim" TextWrapping="Wrap" IsVisible="{Binding ShowStuckNote}"
                       Text="{Binding StuckNote}" />

            <TextBox PlaceholderText="filter checks…" Text="{Binding FilterText}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox SelectedIndex="{Binding GameFilterIndex}" MinWidth="130">
                    <ComboBoxItem Content="Both games" />
                    <ComboBoxItem Content="Ocarina of Time" />
                    <ComboBoxItem Content="Majora's Mask" />
                </ComboBox>
                <CheckBox Content="Hide collected" IsChecked="{Binding HideCollected}" />
                <CheckBox Content="In logic" IsChecked="{Binding OnlyInLogic}"
                          ToolTip.Tip="Only checks reachable with your current items, per the reverse-logic solver." />
            </StackPanel>

            <!-- Cheat: deliberately loud while active so it is never left on by accident. -->
            <CheckBox Content="Force-unlock mode" IsVisible="{Binding DevMode}"
                      IsChecked="{Binding ForceUnlockMode}"
                      Foreground="#F25A4D"
                      ToolTip.Tip="CHEAT: open checks become clickable. Click a check to arm it, then click again to force-complete it — the running game grants its item through the normal pipeline (multiworld items are sent to their owner)." />
            <TextBlock Foreground="#F25A4D" TextWrapping="Wrap" IsVisible="{Binding ForceUnlockMode}"
                       Text="Cheat active: click an open check, then click again to confirm." />
            <Border Height="4" />
        </StackPanel>

        <!-- Virtualized: only visible rows materialize (a seed has thousands). -->
        <ListBox ItemsSource="{Binding VisibleChecks}" Background="Transparent">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem"
                              BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="MinHeight" Value="0" />
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckRowViewModel">
                    <Button Classes="checkRow" Command="{Binding ClickCommand}"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,8,*">
                            <Border Grid.Column="0" CornerRadius="4" Padding="5,1"
                                    Background="{DynamicResource AccentFaintBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock Classes="dim" FontSize="11" Text="{Binding GameTag}" />
                            </Border>
                            <StackPanel Grid.Column="2">
                                <!-- Collected rows go green; unreachable rows go dim;
                                     armed/pending force-unlock states go red/amber. -->
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"
                                           Classes.success="{Binding Collected}"
                                           Classes.dim="{Binding !InLogic}"
                                           Classes.unlockArmed="{Binding IsArmed}"
                                           Classes.unlockPending="{Binding IsPending}" />
                                <TextBlock Classes="dim" FontSize="12" Text="{Binding ItemText}"
                                           IsVisible="{Binding Collected}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

    <UserControl.Styles>
        <Style Selector="TextBlock.unlockArmed">
            <Setter Property="Foreground" Value="#F25A4D" />
        </Style>
        <Style Selector="TextBlock.unlockPending">
            <Setter Property="Foreground" Value="#D9BF66" />
        </Style>
        <Style Selector="Button.checkRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

</UserControl>
