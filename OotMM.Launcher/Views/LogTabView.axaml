<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.LogTabView"
             x:DataType="vm:LogTabViewModel">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="dim" IsVisible="{Binding IsEmpty}"
                   Text="Nothing yet — found checks and received items will appear here." />
        <ListBox ItemsSource="{Binding Entries}" Background="Transparent">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem"
                              BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0,2" />
                    <Setter Property="MinHeight" Value="0" />
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                    <Grid ColumnDefinitions="Auto,10,*">
                        <TextBlock Grid.Column="0" Classes="dim" FontSize="12"
                                   Text="{Binding Time}" VerticalAlignment="Top" />
                        <!-- Remote (multiworld) events tinted amber to stand out
                             from local pickups. -->
                        <TextBlock Grid.Column="2" TextWrapping="Wrap"
                                   Classes.warn="{Binding IsRemote}"
                                   Text="{Binding Message}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
