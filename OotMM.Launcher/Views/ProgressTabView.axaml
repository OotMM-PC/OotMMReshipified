<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.ProgressTabView"
             x:DataType="vm:ProgressTabViewModel">

    <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProgressSectionViewModel">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Classes="sectionTitle" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Classes="dim"
                                               Classes.success="{Binding IsComplete}"
                                               Text="{Binding CountText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
