<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OotMM.Launcher.ViewModels"
             x:Class="OotMM.Launcher.Views.OptionsTabView"
             x:DataType="vm:OptionsTabViewModel">

    <ScrollViewer>
    <StackPanel Spacing="10">
        <TextBlock Classes="sectionTitle" Text="Appearance" />

        <TextBlock Text="Accent theme" />
        <ComboBox SelectedIndex="{Binding ThemeIndex}" MinWidth="200">
            <ComboBoxItem Content="Follow the active game" />
            <ComboBoxItem Content="Always OoT gold" />
            <ComboBoxItem Content="Always MM violet" />
        </ComboBox>

        <TextBlock Text="UI scale" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Slider x:Name="ScaleSlider" Width="200" Minimum="0.75" Maximum="1.5"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    Value="{Binding UiScale}" />
            <TextBlock Classes="dim" Text="{Binding UiScalePercent}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Classes="sectionTitle" Text="Advanced" Margin="0,10,0,0" />
        <CheckBox Content="Enable dev mode (debug &amp; cheat menus)" IsChecked="{Binding DevMode}"
                  ToolTip.Tip="Both games hide their debug, cheats and enhancements menus by default so seeds stay fair. Enabling this unlocks them (next game boot), plus the launcher's force-unlock cheat and manual game switching." />
        <StackPanel Spacing="6" IsVisible="{Binding CheatGatePending}">
            <TextBlock Foreground="#D9BF66" Text="Pending — restart the game to apply." />
            <Button Content="Restart game now" Click="OnRestartGame" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>

</UserControl>
