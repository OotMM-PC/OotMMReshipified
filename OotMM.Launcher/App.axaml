<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OotMM.Launcher"
             x:Class="OotMM.Launcher.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <!-- Resolves FooViewModel -> FooView by naming convention; see ViewLocator.cs. -->
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- The accent trio is swapped at runtime between gold (OoT) and violet (MM)
             by App.ApplyAccent; every accent-colored element must use DynamicResource. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#E0B84C" />
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#F2D27C" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#59E0B84C" />
        <SolidColorBrush x:Key="AccentFaintBrush" Color="#26E0B84C" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OotMM.Launcher/Themes/ZeldaTheme.axaml" />
    </Application.Styles>

</Application>
